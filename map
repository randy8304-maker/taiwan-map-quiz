		flagImg: 'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Kinmen_County.svg/1920px-Flag_of_Kinmen_County.svg.png?utm_source=zh.wikipedia.org&utm_campaign=index&utm_content=thumbnail',
                svg: '<img src="https://upload.wikimedia.org/wikipedia/commons/0/07/2020_%E9%87%91%E9%96%80%E7%B8%A3%E7%AB%8B%E5%A7%94%E7%AC%AC%E4%B8%80%E9%81%B8%E5%8D%80%E9%81%B8%E8%88%89%E5%90%84%E9%87%8C%E5%BE%97%E7%A5%A8.png" style="max-height: 220px; mix-blend-mode: multiply; filter: sepia(0.8) opacity(0.8) drop-shadow(2px 2px 2px rgba(62,39,35,0.3));">' 
            },
  		{ 
                id: 'ph', name: '澎湖縣', flagBg: '#00BFFF', flagSymbol: '澎湖',
                flagImg: 'https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Flag_of_Penghu_County.svg/1920px-Flag_of_Penghu_County.svg.png?utm_source=zh.wikipedia.org&utm_campaign=index&utm_content=thumbnail',
                // 👇 我們在這裡面加了一個帶有白色背景與陰影的容器，讓澎湖地圖跳出來！
                svg: '<div style="background-color: #FFF8E7; padding: 10px; border-radius: 6px; box-shadow: inset 0 0 8px rgba(0,0,0,0.1); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;"><img src="https://media.istockphoto.com/id/1521719751/zh/%E5%90%91%E9%87%8F/penghu-county-map-county-of-the-republic-of-china-taiwan-vector-illustration.jpg?s=612x612&w=0&k=20&c=QrpJro0jUqkfQKgwnjPFS_cGQeHFcFyUd7gZ7-jcPNY=" style="max-height: 200px; mix-blend-mode: multiply; filter: sepia(0.8) opacity(0.9) drop-shadow(2px 2px 2px rgba(62,39,35,0.3));"></div>' 
            },
        ];

        let quizQueue = [];
        let currentIndex = 0;
        let score = 0;
        let history = [];

        const mapDisplay = document.getElementById('map-display');
        const optionsGrid = document.getElementById('options-grid');
        const scoreBoard = document.getElementById('score-board');
        const historyList = document.getElementById('history-list');
        const feedbackModal = document.getElementById('feedback-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalCountyName = document.getElementById('modal-county-name');
        const modalFlag = document.getElementById('modal-flag');
        const btnModalNext = document.getElementById('btn-modal-next');
        const gameContent = document.getElementById('game-content');
        const resultView = document.getElementById('result-view');
        const finalScore = document.getElementById('final-score');
        const resultTier = document.getElementById('result-tier');
        const resultDesc = document.getElementById('result-desc');
        const btnRestart = document.getElementById('btn-restart');

        function shuffle(array) {
            return array.slice().sort(() => Math.random() - 0.5);
        }

        function initQuiz() {
            quizQueue = shuffle(countyData).slice(0, 10);
            currentIndex = 0;
            score = 0;
            history = [];
            
            gameContent.style.display = 'flex';
            resultView.style.display = 'none';
            
            updateScoreBoard();
            renderHistory();
            loadQuestion();
        }

        function loadQuestion() {
            const currentItem = quizQueue[currentIndex];
            mapDisplay.innerHTML = currentItem.svg;

            const incorrectOptions = countyData.filter(item => item.id !== currentItem.id);
            const shuffledIncorrect = shuffle(incorrectOptions).slice(0, 3);
            const choices = shuffle([currentItem, ...shuffledIncorrect]);

            optionsGrid.innerHTML = '';
            choices.forEach(choice => {
                const btn = document.createElement('button');
                btn.className = 'btn-option';
                btn.textContent = choice.name;
                btn.addEventListener('click', () => handleAnswer(choice, currentItem, btn));
                optionsGrid.appendChild(btn);
            });
        }

        function handleAnswer(selected, correct, clickedBtn) {
            const allBtns = optionsGrid.querySelectorAll('.btn-option');
            allBtns.forEach(b => b.disabled = true);

            const isCorrect = selected.id === correct.id;

            if (isCorrect) {
                clickedBtn.classList.add('correct');
                score++;
                modalTitle.textContent = "⭕️ 答對了！";
                modalTitle.style.color = "var(--correct-green)";
                history.push({ name: correct.name, status: '⭕️' });
            } else {
                clickedBtn.classList.add('incorrect');
                modalTitle.textContent = "❌ 答錯了！";
                modalTitle.style.color = "var(--incorrect-red)";
                history.push({ name: correct.name, status: '❌' });
            }

            modalCountyName.textContent = correct.name;
            
            if (correct.flagImg) {
                modalFlag.innerHTML = `<img src="${correct.flagImg}" style="width:100%; height:100%; object-fit:contain;">`;
                modalFlag.style.backgroundColor = '#FAF4E8';
            } else {
                modalFlag.innerHTML = '';
                modalFlag.textContent = correct.flagSymbol;
                modalFlag.style.backgroundColor = correct.flagBg;
            }

            updateScoreBoard();
            renderHistory();

            setTimeout(() => {
                feedbackModal.classList.add('active');
            }, 500);
        }

        btnModalNext.addEventListener('click', () => {
            feedbackModal.classList.remove('active');
            currentIndex++;
            if (currentIndex < quizQueue.length) {
                loadQuestion();
            } else {
                showResults();
            }
        });

        function updateScoreBoard() {
            scoreBoard.textContent = `得分: ${score} / ${quizQueue.length}`;
        }

        function renderHistory() {
            historyList.innerHTML = '';
            history.forEach(item => {
                const li = document.createElement('li');
                li.className = 'history-item';
                li.innerHTML = `<span>${item.name}</span><span>${item.status}</span>`;
                historyList.appendChild(li);
            });
        }

        function showResults() {
            gameContent.style.display = 'none';
            resultView.style.display = 'flex';
            
            const total = quizQueue.length;
            const percentage = (score / total) * 100;
            
            finalScore.textContent = `最終成績: ${score} / ${total}`;

            let tier = '';
            let desc = '';

            if (percentage >= 90) {
                tier = '台灣地理大師 (Legendary Cartographer)';
                desc = '「您就是活著的台灣地圖！」';
            } else if (percentage >= 60) {
                tier = '熟門熟路的旅人 (Seasoned Traveler)';
                desc = '「方向感極佳，台灣走透透！」';
            } else if (percentage >= 30) {
                tier = '偶爾出門的鄉民 (Occasional Explorer)';
                desc = '「知道個大概，但常常會迷路喔。」';
            } else {
                tier = '超級大路痴 (Lost Navigator)';
                desc = '「建議您出門一定要隨身攜帶導航...」';
            }

            resultTier.textContent = tier;
            resultDesc.textContent = desc;
        }

        btnRestart.addEventListener('click', initQuiz);
        window.addEventListener('DOMContentLoaded', initQuiz);
    </script>
</body>
</html>
